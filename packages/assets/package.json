{
  "name": "@mcgui/assets",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": { "node": ">=22.18" },
  "files": [
    "dist"
  ],
  "bin": {
    "mcgui-assets": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').mkdirSync('dist/java',{recursive:true});require('node:fs').copyFileSync('src/java/McguiCatalogue.java','dist/java/McguiCatalogue.java')\""
  },
  "dependencies": {
    "@mcgui/core": "0.1.0",
    "pngjs": "^7.0.0",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  }
}
