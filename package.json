{
  "name": "mcgui-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mcgui/core && npm run build --workspace @mcgui/assets && npm run build --workspace @mcgui/react && npm run build --workspace @mcgui/storybook",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "dev": "npm run dev --workspace @mcgui/storybook",
    "assets": "node --import tsx packages/assets/src/cli.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "test:storybook-browser": "node scripts/storybook-browser-test.mjs",
    "test:inventory-browser": "node scripts/inventory-browser-test.mjs",
    "test:item-movement-browser": "node scripts/item-movement-browser-test.mjs",
    "test:creative-browser": "node scripts/creative-browser-test.mjs",
    "test:canvas-browser": "node scripts/canvas-browser-test.mjs",
    "bench:renderers": "node scripts/renderer-benchmark.mjs",
    "test:controls-browser": "node scripts/controls-browser-test.mjs",
    "test:slider-browser": "node scripts/slider-browser-test.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:consumers": "node --import tsx scripts/check-consumers.mjs",
    "prepare:demo-pack": "node scripts/prepare-demo-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^6.3.0",
    "playwright": "^1.55.0"
  }
}
